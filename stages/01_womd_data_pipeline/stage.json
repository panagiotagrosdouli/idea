{
  "id": "stage1",
  "title": "Freeze and verify causal WOMD train/validation corpora",
  "depends_on": ["stage0"],
  "required_inputs": ["${TRAIN_NPZ}", "${VALIDATION_NPZ}"],
  "outputs": [
    "artifacts/paper_final/01_data/training_audit.json",
    "artifacts/paper_final/01_data/validation_audit.json",
    "artifacts/paper_final/01_data/corpus_verification.json"
  ],
  "acceptance": [
    "true-SDC geometry",
    "11 history and 80 future states",
    "finite arrays",
    "scenario-safe labels",
    "zero scenario overlap between training and untouched validation",
    "SHA-256 hashes recorded for both frozen corpora"
  ],
  "commands": [
    ["python", "scripts/08_audit_womd_dataset.py", "${TRAIN_NPZ}", "--output", "artifacts/paper_final/01_data/training_audit.json"],
    ["python", "scripts/08_audit_womd_dataset.py", "${VALIDATION_NPZ}", "--output", "artifacts/paper_final/01_data/validation_audit.json"],
    ["python", "scripts/01_verify_womd_corpora.py", "${TRAIN_NPZ}", "${VALIDATION_NPZ}", "--output", "artifacts/paper_final/01_data/corpus_verification.json"]
  ]
}
