{
  "project": "Predictive PC-FMCW/DPSK Vehicular Communication Scheduling",
  "dataset": "Waymo Open Motion Dataset v1.3.1",
  "stages": [
    {
      "id": "stage0",
      "title": "Freeze protocol, data provenance and leakage gates",
      "depends_on": [],
      "required_inputs": ["${TRAIN_NPZ}", "${VALIDATION_NPZ}", "configs/default.json"],
      "outputs": ["artifacts/paper_final/split_audit.json", "artifacts/paper_final/paper_manifest.json"],
      "acceptance": ["training and official validation hashes recorded", "zero overlapping scenario IDs", "official validation remains untouched"],
      "commands": [
        ["python", "scripts/00_audit_womd_split_integrity.py", "training=${TRAIN_NPZ}", "official_validation=${VALIDATION_NPZ}", "--output", "artifacts/paper_final/split_audit.json"],
        ["python", "scripts/00_freeze_paper_manifest.py", "--training-npz", "${TRAIN_NPZ}", "--validation-npz", "${VALIDATION_NPZ}", "--womd-release", "v1.3.1", "--output", "artifacts/paper_final/paper_manifest.json"]
      ]
    },
    {
      "id": "stage1",
      "title": "Audit causal WOMD trajectory samples",
      "depends_on": ["stage0"],
      "required_inputs": ["${TRAIN_NPZ}", "${VALIDATION_NPZ}"],
      "outputs": ["artifacts/paper_final/training_audit.json", "artifacts/paper_final/validation_audit.json"],
      "acceptance": ["true-SDC geometry", "11 history and 80 future states", "finite arrays", "scenario-safe labels"],
      "commands": [
        ["python", "scripts/08_audit_womd_dataset.py", "${TRAIN_NPZ}", "--output", "artifacts/paper_final/training_audit.json"],
        ["python", "scripts/08_audit_womd_dataset.py", "${VALIDATION_NPZ}", "--output", "artifacts/paper_final/validation_audit.json"]
      ]
    },
    {
      "id": "stage2",
      "title": "Freeze Part-A PC-FMCW/DPSK physical layer",
      "depends_on": ["stage1"],
      "required_inputs": ["configs/part_a_physical_layer.json"],
      "outputs": ["artifacts/paper_final/ber/dbpsk_ber_lut.csv"],
      "acceptance": ["31 SNR points", "confidence-aware BER", "monotone conservative LUT", "uncalibrated absolute power disclosed"],
      "commands": [
        ["python", "scripts/02_build_part_a_link_lut.py", "--receiver", "part-a-notebook", "--bits", "250000", "--seed", "20260827", "--output", "artifacts/paper_final/ber/dbpsk_ber_lut.csv"]
      ]
    },
    {
      "id": "stage3",
      "title": "Classical causal motion and link baselines",
      "depends_on": ["stage2"],
      "required_inputs": ["${TRAIN_NPZ}"],
      "outputs": ["artifacts/paper_final/motion_baselines/forecast_summary.json"],
      "acceptance": ["Last/CV/CA/Kalman/IMM evaluated", "ADE/FDE and link metrics recorded", "no future information used"],
      "commands": [
        ["python", "scripts/03_eval_npz_baselines.py", "${TRAIN_NPZ}", "--split", "development", "--output", "artifacts/paper_final/motion_baselines"]
      ]
    },
    {
      "id": "stage4",
      "title": "Communication-aware GRU selection and five-seed training",
      "depends_on": ["stage3"],
      "required_inputs": ["${TRAIN_NPZ}"],
      "outputs": ["artifacts/paper_final/learned_ablation/completion_manifest.json"],
      "acceptance": ["lambda selected on development only", "four objectives times five seeds", "20 verified checkpoints", "dataset/config hashes embedded"],
      "commands": [
        ["python", "scripts/04_run_lambda_sweep.py", "${TRAIN_NPZ}", "--output", "artifacts/paper_final/lambda_sweep", "--epochs", "80", "--batch-size", "32", "--seeds", "20260827", "20260828", "20260829", "20260830", "20260831"],
        ["python", "scripts/04_run_training_ablation.py", "${TRAIN_NPZ}", "--output", "artifacts/paper_final/learned_ablation", "--epochs", "80", "--batch-size", "32", "--seeds", "20260827", "20260828", "20260829", "20260830", "20260831", "--lambda-link", "${LAMBDA_LINK}", "--lambda-outage", "${LAMBDA_OUTAGE}"]
      ]
    },
    {
      "id": "stage5",
      "title": "Untouched official-validation predictor evaluation",
      "depends_on": ["stage4"],
      "required_inputs": ["${TRAIN_NPZ}", "${VALIDATION_NPZ}", "artifacts/paper_final/learned_ablation/completion_manifest.json"],
      "outputs": ["artifacts/paper_final/heldout_learned/heldout_summary.json"],
      "acceptance": ["ADE/FDE", "range/bearing/SNR/goodput/lifetime", "outage F1/AUROC", "development-fitted NLL and coverage"],
      "commands": [
        ["python", "scripts/06_evaluate_learned_checkpoints.py", "${VALIDATION_NPZ}", "${CHECKPOINT_GLOB}", "--development-npz", "${TRAIN_NPZ}", "--output", "artifacts/paper_final/heldout_learned"]
      ]
    },
    {
      "id": "stage6",
      "title": "Paired official-WOMD packet scheduling",
      "depends_on": ["stage5"],
      "required_inputs": ["${VALIDATION_TFRECORD}", "artifacts/paper_final/heldout_learned/heldout_summary.json"],
      "outputs": ["artifacts/paper_final/official_scheduler/completed_runs.json"],
      "acceptance": ["eight scheduler families", "five paired traffic seeds", "ground-truth packet realization", "per-scenario raw metrics"],
      "commands": [
        ["python", "scripts/06_evaluate_learned_scheduler_womd.py", "${VALIDATION_TFRECORD}", "--checkpoints", "${CHECKPOINT_GLOB}", "--output", "artifacts/paper_final/official_scheduler"]
      ]
    },
    {
      "id": "stage7",
      "title": "Operating regions, clustered statistics and paper artifacts",
      "depends_on": ["stage6"],
      "required_inputs": ["artifacts/paper_final/official_scheduler/completed_runs.json"],
      "outputs": ["artifacts/paper_final/learned_analysis/learned_heldout_analysis.json", "artifacts/paper_final/statistics/scheduler_utility_summary.json"],
      "acceptance": ["scenario-cluster bootstrap", "paired Wilcoxon and t-test", "Holm families", "horizon/N/load/slice results", "ADE-to-goodput join"],
      "commands": [
        ["python", "scripts/07_analyze_learned_results.py", "artifacts/paper_final/heldout_learned/heldout_metrics_by_scenario.csv", "--output", "artifacts/paper_final/learned_analysis"],
        ["python", "scripts/07_analyze_scheduler_utility.py", "artifacts/paper_final/heldout_learned/heldout_metrics_by_scenario.csv", "artifacts/paper_final/official_scheduler", "--output", "artifacts/paper_final/statistics"]
      ]
    },
    {
      "id": "stage8",
      "title": "Final manuscript and clean reproduction",
      "depends_on": ["stage7"],
      "required_inputs": ["artifacts/paper_final/learned_analysis/learned_heldout_analysis.json", "artifacts/paper_final/statistics/scheduler_utility_summary.json"],
      "outputs": ["output/pdf/predictive_pc_fmcw_final_paper.pdf", "artifacts/paper_final/reproducibility_manifest.json"],
      "acceptance": ["official figures and LaTeX tables", "claims follow evidence", "measured limitations disclosed", "clean one-command reproduction"],
      "commands": [
        ["python", "scripts/build_reproducibility_manifest.py", "--output", "artifacts/paper_final/reproducibility_manifest.json"],
        ["python", "scripts/build_paper_pdf.py"]
      ]
    }
  ]
}
